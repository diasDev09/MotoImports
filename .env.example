# Copie este arquivo para .env.local (que o Git ignora) e preencha com os dados do seu projeto Firebase.
# Console do Firebase > Configurações do projeto > Seus apps > App da Web > "firebaseConfig".
# Estes valores identificam o projeto e não são segredos: quem protege os dados são as regras do Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
